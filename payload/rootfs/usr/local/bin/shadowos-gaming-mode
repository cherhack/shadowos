#!/usr/bin/env bash
set -u

mode="${1:-}"
tool="$HOME/.local/bin/rice-effects"
runtime="${XDG_RUNTIME_DIR:-/tmp/shadowos-$UID}"
marker="$runtime/shadowos-gamemode-auto"
mkdir -p "$runtime"

[[ -x "$tool" ]] || exit 0

case "$mode" in
    on)
        if ! "$tool" state 2>/dev/null | grep -q '"gaming": true'; then
            : > "$marker"
            "$tool" gaming on
        fi
        ;;
    off)
        if [[ -f "$marker" ]]; then
            rm -f "$marker"
            "$tool" gaming off
        fi
        ;;
    *)
        echo "usage: shadowos-gaming-mode on|off" >&2
        exit 2
        ;;
esac
